# A project board pipeline. Copy to product.yaml (any name.yaml) and set `project`.
# Each column maps a harness (agents: profiles with their tools, skills, MCP servers)
# and a role (what to do in this column: a library/roles name, or inline text).
#
# A column can have several agents, and group:<name> adds a whole group. `mode` says
# how a card is handed out:
#   pool  (default) one agent per card, the least busy one
#   all   every agent works the card at once; it moves when they've all finished
#         (needs-human wins, then sending it back, then the most common choice)
#   label route by the issue's labels:  routes: { frontend: web-dev, default: group:developers }
project: your-org/1            # org/project-number (organization projects get webhooks)
status_field: Status           # the single-select field the board is grouped by
needs_human: Needs human       # where loop guards send cards (add this column to the project)
poll_seconds: 60               # also poll, in case a webhook is missed (0 to disable)
# token_env: PROJECT_TOKEN     # only if the GitHub App can't reach the project (e.g. a
#                              # user-owned project): name of an env var holding a token
#                              # with project read/write access
limits:
  moves_per_issue: 10          # agent moves per card before it goes to needs_human
  entries_per_column: 3        # times a card may come back to the same column
  budget_usd_per_issue: 30     # stop when agents have spent this much on a card

# Optional: kinds of card (by issue label) agents may not move into some columns.
# work_types:
#   docs:
#     labels: [documentation]
#     forbid: [In review]
#
# Optional, per column: what an agent must show to move a card INTO that column.
# move_to_column refuses the move with what's missing; people can still move cards anywhere.
#   evidence:          pull_request | pushed | tests | review | approval | merged | sub_issues
#                      (merged: the card's branch is in the branch it targets, e.g. its parent's;
#                       sub_issues: every sub-issue's branch is merged into this card's branch)
#   test_command:      for tests: command(s) that count (default: common test runners)
#   handoff_required:  status | decisions | verified | open_questions | risks | do_not_redo
#
# Optional: sub-issues. Agents with github.sub_issues: write can split a card into sub-issues;
# they go on the board in `column`. An agent on the parent card may move them to `moves_to`.
# sub_issues:
#   column: Backlog
#   moves_to: [Ready]
#
# Optional: project fields for dates and estimates (add them to the project first:
# two date fields and a number field). Agents set them with set_card_fields.
# fields:
#   start: Start date
#   end: End date
#   estimate: Estimate
#   start_on: [In progress]    # fill in the start date when a card enters these
#   end_on: [Done]             # set the end date when a card enters these

columns:
  Backlog:
    agent: analyst
    role: requirements
    effort: medium
    moves_to: [Ready]
  Ready:
    agents: [coder]             # e.g. [group:developers] to spread cards over a team
    mode: pool
    role: implement
    on_start: In progress      # moved here when the agent starts
    effort: high
    moves_to: [In review]
  In progress:
    agent: coder
    role: address-feedback     # cards sent back from review land here
    moves_to: [In review]
  In review:
    agents: [tester]            # e.g. [tester, security-reviewer] with mode: all
    role: verify
    moves_to: [Done, In progress]
    # evidence: [pull_request]          # the developer's PR has their latest commit
    # handoff_required: [status]
  Done: {}                     # no agent; agents never merge
    # e.g. Done: { evidence: [approval, tests], handoff_required: [verified, risks] }
