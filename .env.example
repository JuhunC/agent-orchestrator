# ---- Where the orchestrator lives ----
# The public address GitHub sends webhooks to and admins open in a browser, e.g.
# https://agents.example.com or, on a server without a domain, http://203.0.113.7:3000.
# Set it BEFORE creating the GitHub App: the App's Callback URL (GitHub sign-in) and
# webhook URL are made from it. If it changes later, update them in the App's settings.
PUBLIC_URL=http://localhost:3000
PORT=3000

# ---- Which GitHub ----
# github.com by default. For GitHub Enterprise Server, set your server's URL;
# the API URL is derived (https://ghe.example.com/api/v3) unless GITHUB_API_URL is set.
GITHUB_URL=https://github.com
# GITHUB_API_URL=

# ---- The model service agents use (Claude Agent SDK) ----
# Anthropic's API:
# ANTHROPIC_API_KEY=sk-ant-...
# Or any Anthropic-compatible service (a gateway, proxy or other provider):
# ANTHROPIC_BASE_URL=https://your-service.example.com
# ANTHROPIC_AUTH_TOKEN=your-service-key
# Or a Claude subscription token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=
# Model names your service expects (agents can override per profile):
# ANTHROPIC_MODEL=
# ANTHROPIC_SMALL_FAST_MODEL=
# Run your own Claude Code-compatible executable instead of the one bundled with the SDK
# (a path, or a command on PATH). It gets the same flags and must speak the same stream-json:
# CLAUDE_CODE_EXECUTABLE=/opt/my-claude/bin/claude
# Extra variables to pass to agents (comma separated), e.g. tokens your MCP servers need
# via ${NAME} in mcp.json:
# AGENT_ENV_PASSTHROUGH=LINEAR_API_KEY
# AGENT_USER=agent                 # the OS user agents run as (set in the Docker image): it can't read
#                                  # the orchestrator's data. Outside Docker, see README → Security.
# AGENT_ISOLATION=auto             # auto | required (don't run agents unisolated) | off
# MODEL_PROXY=on                   # agents get a per-session model credential, not the real key (off = the real one)

# ---- GitHub App ----
# Leave empty to create the app from the admin UI (Settings → Create GitHub App);
# its credentials are then kept in the data volume.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Admin UI ----
# GitHub logins allowed to sign in with GitHub (comma separated).
ADMIN_USERS=
# Token for signing in without GitHub. Generated into the data volume if empty.
ADMIN_TOKEN=

# ---- Behaviour ----
# MAX_CONCURRENT_TASKS=2
# TASK_TIMEOUT_MINUTES=60
# LIVE_SESSION_IDLE_MINUTES=30     # how long an agent's session stays open after a task
# MAX_LIVE_SESSIONS=4
# USAGE_LIMIT_RETRIES=5            # pauses for usage limits before a task fails
# MODEL_ERROR_RETRIES=3            # when the model API fails to answer (5xx, overloaded, dropped
#                                  # connection): retries per request, then per task
# MODEL_ERROR_RETRY_DELAY_SECONDS=20   # first wait before a task retry; doubles each time
# MAX_PULL_REQUESTS_PER_ISSUE=0    # most PRs agents may open for one issue, open or closed (0 = no limit)
# SPEND_LIMIT_DAILY_USD=50         # all agents together, per UTC day: new tasks wait once it's reached
# SPEND_LIMIT_MONTHLY_USD=1000     # the same per UTC month (Settings can change both)
# MAX_AGENT_CHAIN=3                # agents in a row that may start each other on related issues (0 = off)
# CODER_GITHUB_TOKEN=             # e.g. for an agent with github.account_token_env: CODER_GITHUB_TOKEN
#                                  # (it acts as that GitHub account; or register one on the agent's page)
# API_TIMEOUT_MS=600000            # how long to wait for the model API to answer a request
# PROGRESS_UPDATE_SECONDS=20
# HISTORY_LIMIT=10
# TRIGGER_MIN_PERMISSION=write     # who may start agents: read, triage, write, maintain, admin
# ALLOWED_REPOS=                   # owner/repo or owner/*; empty = wherever the app is installed
# AGENT_LABEL_PREFIX=agent:        # "none" to disable

# ---- Local development ----
# WEBHOOK_PROXY_URL=https://smee.io/your-channel   # when GitHub can't reach PUBLIC_URL
# AUTH_DISABLED=true

# ---- docker compose (deploy/docker-compose.yml) ----
# DOMAIN=orchestrator.example.com   # with `--profile https`, Caddy gets a certificate for it
# BIND_ADDRESS=127.0.0.1            # when Caddy or another proxy is in front
