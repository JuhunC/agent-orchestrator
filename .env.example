# ---- Where the orchestrator lives ----
# The public address GitHub sends webhooks to and admins open in a browser.
PUBLIC_URL=https://orchestrator.example.com
PORT=3000

# ---- Which GitHub ----
# github.com by default. For GitHub Enterprise Server, set your server's URL;
# the API URL is derived (https://ghe.example.com/api/v3) unless GITHUB_API_URL is set.
GITHUB_URL=https://github.com
# GITHUB_API_URL=

# ---- GitHub App ----
# Leave these empty to create the app from the admin UI (Settings → Create GitHub App);
# its credentials are then kept in the data volume.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Admin UI ----
# GitHub logins allowed to sign in with GitHub (comma separated).
ADMIN_USERS=
# Token for signing in without GitHub. Generated into the data volume if empty.
ADMIN_TOKEN=
# SESSION_SECRET=

# ---- Agent credentials (passed to the agent processes, nothing else is) ----
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=   # from `claude setup-token`, to use a Claude subscription
CURSOR_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Extra variable names to pass through to agents, comma separated.
# AGENT_ENV_PASSTHROUGH=MY_CLAUDE_API_KEY

# ---- Behaviour ----
# MAX_CONCURRENT_TASKS=2
# TASK_TIMEOUT_MINUTES=60
# PROGRESS_UPDATE_SECONDS=20
# HISTORY_LIMIT=10
# Who may start agents: read, triage, write, maintain or admin.
# TRIGGER_MIN_PERMISSION=write
# Only these repos (owner/repo or owner/*). Empty = any repo the app is installed on.
# ALLOWED_REPOS=
# Label added to threads an agent works on ("none" to disable).
# AGENT_LABEL_PREFIX=agent:

# ---- Local development ----
# Relay webhooks through https://smee.io when PUBLIC_URL isn't reachable from GitHub.
# WEBHOOK_PROXY_URL=https://smee.io/your-channel
# AUTH_DISABLED=true

# ---- docker compose (deploy/docker-compose.yml) ----
# DOMAIN=orchestrator.example.com   # with `--profile https`, Caddy gets a certificate for it
# BIND_ADDRESS=127.0.0.1            # when Caddy or another proxy is in front
