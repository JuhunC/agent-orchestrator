{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Runs AI coding agents from GitHub mentions, via a GitHub App, with an admin UI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.7",
    "octokit": "^5.0.5",
    "smee-client": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
